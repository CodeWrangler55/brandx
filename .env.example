# Copy to .env for a local install. Never commit .env.
APP_ENV=local
APP_MODE=mock
APP_BASE_URL=https://your-demo-domain.example
APP_ADMIN_PASSWORD=replace-with-a-long-password
APP_TOOL_TOKEN=replace-with-a-random-32-character-token

# Paste your Bland organization API key here.
BLAND_API_KEY=
BLAND_AGENT_ID=
BLAND_WEBHOOK_SECRET=
